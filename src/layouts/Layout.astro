---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/site.css';
import { ClientRouter } from 'astro:transitions';
import { getAllBlogPosts } from '../lib/content';
import { cv } from '../data/cv';
import PittaMark from '../components/PittaMark.astro';

interface Props {
  // The page's own name; the handle is added after it. Leave it out on the home page.
  title?: string;
  description?: string;
  ogImage?: string;
  // The Work grid uses the full width; reading pages keep their text to a
  // comfortable column. The frame, header and footer are the same on every page.
  wide?: boolean;
}

const {
  title: pageTitle,
  description = cv.tagline,
  ogImage = '/og-default.png',
  wide = false,
} = Astro.props;

const title = pageTitle ? `${pageTitle} — ${cv.handle}` : cv.handle;
const base = Astro.site ?? Astro.url;
const fullUrl = new URL(Astro.url.pathname, base).href;
const imageUrl = new URL(ogImage, base).href;
const isGeneratedImage = ogImage.startsWith('/og/');
const year = new Date().getFullYear();
const hasFeed = getAllBlogPosts().length > 0;

const NAV = [
  { label: 'Work', href: '/', matches: (path: string) => path === '/' || path.startsWith('/projects') },
  { label: 'About', href: '/about', matches: (path: string) => path.startsWith('/about') },
  { label: 'Writing', href: '/blog', matches: (path: string) => path.startsWith('/blog') },
  { label: 'Contact', href: '/contact', matches: (path: string) => path.startsWith('/contact') },
];
const currentPath = Astro.url.pathname;

const SOCIAL_ICONS: Record<string, string> = {
  GitHub:
    'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  LinkedIn:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-1630328957478630" />
    <link rel="canonical" href={fullUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={isGeneratedImage ? '1200' : '512'} />
    <meta property="og:image:height" content={isGeneratedImage ? '630' : '512'} />
    <meta name="twitter:card" content={isGeneratedImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title={`${cv.name} — Writing`} href="/rss.xml" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/new-favicon_svg.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Apply a saved theme before first paint so the page never flashes the other palette.
         The router replaces <html>'s attributes on every navigation, so it runs again after each swap. -->
    <script is:inline>
      function applySavedTheme() {
        try {
          const saved = localStorage.getItem('theme')
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved
        } catch {
          // Storage blocked: fall back to the system setting.
        }
      }
      applySavedTheme()
      if (!window.__themeOnSwap) {
        window.__themeOnSwap = true
        document.addEventListener('astro:after-swap', applySavedTheme)
      }
    </script>
    <!-- Swaps only the page body on navigation, so the header stays put instead of repainting. -->
    <ClientRouter />
  </head>
  <body>
    <div class="page">
      <header class="site-header" transition:animate="none">
        <a class="site-name" href="/"><PittaMark />fairy pitta</a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} aria-current={item.matches(currentPath) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <span class="site-social">
          {cv.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={SOCIAL_ICONS[link.label]}></path>
              </svg>
            </a>
          ))}
        </span>
        <!-- Persisted across navigations, so it keeps its listeners and never re-hides. -->
        <button type="button" class="theme-toggle" id="theme-toggle" hidden transition:persist="theme-toggle">
          <span class="theme-icon" data-icon="light" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5"></circle>
              <path d="M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M19.4 4.6l-1.8 1.8M6.4 17.6l-1.8 1.8"></path>
            </svg>
          </span>
          <span class="theme-icon" data-icon="dark" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M20.8 13.4A8.5 8.5 0 1 1 10.6 3.2a7 7 0 0 0 10.2 10.2z"></path>
            </svg>
          </span>
          <span id="theme-label"></span>
        </button>
      </header>
      <main class:list={['content', { 'content-reading': !wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        © {year} {cv.name} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>{hasFeed && <> · <a href="/rss.xml">RSS</a></>}
      </footer>
    </div>

    <script>
      import { nextTheme, readStoredTheme, resolveTheme, storeTheme, toggleView, type Theme } from '../lib/theme';

      const button = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      const label = document.getElementById('theme-label');
      const icons = document.querySelectorAll<HTMLElement>('.theme-icon');
      const root = document.documentElement;
      const system = window.matchMedia('(prefers-color-scheme: dark)');

      function storage(): Storage | null {
        try {
          return window.localStorage;
        } catch {
          return null;
        }
      }

      function current(): Theme {
        return resolveTheme(readStoredTheme(storage()), system.matches);
      }

      // The button shows the theme it will switch to, icon included, so its
      // meaning does not depend on knowing which theme is already on.
      function render(theme: Theme) {
        if (!button) return;
        const view = toggleView(theme);
        if (label) label.textContent = view.label;
        for (const icon of icons) icon.hidden = icon.dataset.icon !== view.target;
        button.setAttribute('aria-label', view.ariaLabel);
      }

      // The router builds each new page in a detached document, where videos fail
      // to load and never retry once inserted. Start any such video over.
      document.addEventListener('astro:page-load', () => {
        for (const video of document.querySelectorAll('video')) {
          if (video.error) video.load();
        }
      });

      if (button) {
        render(current());
        button.hidden = false;
        button.addEventListener('click', () => {
          const theme = nextTheme(current());
          root.dataset.theme = theme;
          storeTheme(storage(), theme);
          render(theme);
        });
        // Keep the label right when the OS setting changes and nothing was chosen.
        system.addEventListener('change', () => render(current()));
      }
    </script>
  </body>
</html>
