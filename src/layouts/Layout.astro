---
import '../styles/globals.css';
const {
  title = 'Fairy Pitta | Software Engineer',
  description = 'Portfolio of Fairy Pitta, a software engineer based in Singapore.',
  ogImage,
} = Astro.props;

// OGP画像: 動的画像があればそちらを使用、なければロゴ
const ogImagePath = ogImage || '/new-favicon.png';

// URL生成: devではAstro.url基準の絶対URL、本番ではAstro.siteを使用
const canonicalPath = Astro.url.pathname;
const fullUrl = Astro.site ? new URL(canonicalPath, Astro.site).href : Astro.url.href;
const imageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : new URL(ogImagePath, Astro.url).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Fairy Pitta logo" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Fairy Pitta Blog" href="/rss.xml" />
    <!-- Favicon and app icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/new-favicon_t.png" />
    <link rel="icon" type="image/svg+xml" href="/new-favicon_svg.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Google Fonts: JetBrains Mono + Source Sans 3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=JetBrains+Mono:wght@400;500;700&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=JetBrains+Mono:wght@400;500;700&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap"></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>