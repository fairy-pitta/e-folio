---
import type { JobWork } from '../lib/content';
import Tile, { type TileSize } from './Tile.astro';

interface Props {
  project: JobWork;
  size: TileSize;
}

const { project, size } = Astro.props;
const { data } = project;
---

<Tile
  href={`/work/${project.id}`}
  kind="work"
  size={size}
  kicker={data.kind === 'internal' ? 'Internal project' : 'Client project'}
  title={data.title}
  text={data.summary}
  note={data.highlight}
  cta="Read the case study"
/>
