---
import { projectStatus, runsInTerminal, screenTitle, statusLabel, type Project } from '../lib/content';
import { resolveMedia } from '../lib/media';
import Tile, { type TileSize } from './Tile.astro';

interface Props {
  project: Project;
  size: TileSize;
  // The first row of tiles is above the fold, so its media loads eagerly.
  priority?: boolean;
}

const { project, size, priority = false } = Astro.props;
const { data } = project;
const cover = data.media.cover;
const media = cover ? await resolveMedia(cover) : undefined;
---

<Tile
  href={`/projects/${project.slug}`}
  kind="project"
  size={size}
  title={data.title}
  text={data.summary}
  status={statusLabel(projectStatus(data.links))}
  cta="Learn more"
  screen={media && {
    media,
    variant: runsInTerminal(data) ? 'terminal' : 'browser',
    title: screenTitle(project.slug, data),
    priority,
  }}
/>
