---
import { statusLabel, type ProjectStatus } from '../lib/content';

// A personal project's status in a small, quiet pill. Only "Live" has a dot.
interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;
---

<span class:list={['stamp', `stamp-${status.toLowerCase()}`]}>{status === 'LIVE' && <span class="stamp-dot" aria-hidden="true"></span>}{statusLabel(status)}</span>
