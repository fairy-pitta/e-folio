---
const currentYear = new Date().getFullYear()
---
<footer class="py-10 border-t">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-start gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <img
            src="/new-favicon.png"
            alt="Fairy Pitta"
            class="h-6 w-6 object-contain"
            width="24"
            height="24"
            loading="lazy"
            decoding="async"
          />
          <span class="font-caveat text-xl">Fairy Pitta</span>
        </div>
        <p class="text-sm text-muted-foreground">I Code Birds.</p>
      </div>

      <div class="flex items-center gap-6 text-sm">
        <a
          href="https://github.com/fairy-pitta"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground hover:text-foreground transition-colors font-mono"
        >
          GitHub
        </a>
        <a
          href="https://qiita.com/Pitta"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground hover:text-foreground transition-colors font-mono"
        >
          Qiita
        </a>
        <a href="/privacy" class="text-muted-foreground hover:text-foreground transition-colors" data-astro-prefetch>
          Privacy
        </a>
        <a href="/terms" class="text-muted-foreground hover:text-foreground transition-colors" data-astro-prefetch>
          Terms
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t">
      <p class="text-xs text-muted-foreground">&copy; {currentYear} fairy-pitta</p>
    </div>
  </div>
</footer>
