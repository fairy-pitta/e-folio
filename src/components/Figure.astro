---
import { resolveMedia } from '../lib/media';
import MediaElement from './MediaElement.astro';

interface Props {
  src: string;
  alt: string;
  // Set on the cover image: it is the largest thing above the fold, so it loads
  // eagerly and at high priority instead of waiting its turn.
  priority?: boolean;
}

const { src, alt, priority = false } = Astro.props;
const media = await resolveMedia(src);
---

<figure class="figure">
  <MediaElement media={media} alt={alt} priority={priority} />
</figure>
