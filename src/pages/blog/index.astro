---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import WritingRow from '../../components/WritingRow.astro';
import { getAllBlogPosts } from '../../lib/collections';
import { fetchQiita, QIITA_UNAVAILABLE } from '../../lib/qiita';
import { toWritingItems } from '../../lib/writing';
import { cv } from '../../data/cv';

const posts = await getAllBlogPosts();
const qiita = await fetchQiita();
const items = toWritingItems(posts, qiita.items);
// Marks the list only when Qiita could not be reached, so the checks on the
// built site skip the Qiita assertion instead of failing.
const qiitaStatus = qiita.ok ? undefined : QIITA_UNAVAILABLE;
---

<Layout title="Writing" description={`Notes on software engineering by ${cv.name}.`}>
  <PageHead title="Writing" lead="Notes on software engineering. Most are on Qiita, in Japanese.">
    {posts.length > 0 && (
      <p class="actions rise" style="--i:3"><a class="action" href="/rss.xml">RSS feed</a></p>
    )}
  </PageHead>
  {items.length > 0 ? (
    <div class="section" data-qiita={qiitaStatus}>
      <div class="list">
        {items.map((item) => <WritingRow item={item} />)}
      </div>
    </div>
  ) : (
    <p class="section muted" data-qiita={qiitaStatus}>Nothing published yet.</p>
  )}
</Layout>
