---
import Layout from '../../layouts/Layout.astro';
import WritingRow from '../../components/WritingRow.astro';
import { getAllBlogPosts } from '../../lib/content';
import { fetchQiitaItems } from '../../lib/qiita';
import { toWritingItems } from '../../lib/writing';
import { cv } from '../../data/cv';

const posts = getAllBlogPosts();
const items = toWritingItems(posts, await fetchQiitaItems());
---

<Layout title="Writing" description={`Notes on software engineering by ${cv.name}.`}>
  <header class="page-head">
    <p class="eyebrow eyebrow-path rise" style="--i:0"><a href="/">fairy-pitta</a>/writing/</p>
    <h1 class="page-title rise" style="--i:1">Writing</h1>
    <p class="lead rise" style="--i:2">Notes on software engineering. Most are on Qiita, in Japanese.</p>
    {posts.length > 0 && (
      <p class="actions rise" style="--i:3"><a class="action" href="/rss.xml">RSS feed<span class="action-arrow" aria-hidden="true">→</span></a></p>
    )}
  </header>
  {items.length > 0 ? (
    <div class="section">
      <div class="list">
        {items.map((item) => <WritingRow item={item} />)}
      </div>
    </div>
  ) : (
    <p class="section muted">Nothing published yet.</p>
  )}
</Layout>
