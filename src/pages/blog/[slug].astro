---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import LabelList from '../../components/LabelList.astro';
import { formatDate, type BlogPost } from '../../lib/content';
import { getAllBlogPosts } from '../../lib/collections';
import { markdownToHtml } from '../../lib/markdown';

export async function getStaticPaths() {
  return (await getAllBlogPosts()).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { data } = post;
const html = await markdownToHtml(post.content);
const date = formatDate(post.date);
---

<Layout
  title={data.title}
  description={data.excerpt}
  ogImage={`/og/blog-${post.slug}.png`}
>
  <PageHead title={data.title} lead={data.excerpt}>
    <LabelList
      rise={3}
      items={[
        date && { label: 'Published', value: date },
        data.readTime && { label: 'Reading time', value: data.readTime },
        data.tags.length > 0 && { label: 'Tags', value: data.tags.join(', ') },
      ]}
    />
  </PageHead>
  <article class="prose" set:html={html} />
  <p class="footer-nav"><a class="link-more" href="/blog">All writing</a></p>
</Layout>
