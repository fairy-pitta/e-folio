---
// Without this page Cloudflare Pages answers every unknown path with the
// homepage and a 200, which reads to a crawler as endless duplicate pages.
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
---

<Layout title="Page not found" description="This page does not exist.">
  <PageHead title="Page not found" lead="That page does not exist. It may have been renamed or removed.">
    <p class="actions rise" style="--i:3">
      <a class="action action-primary" href="/">Work</a>
      <a class="action" href="/about">About</a>
    </p>
  </PageHead>
</Layout>
