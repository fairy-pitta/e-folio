---
// Without this page Cloudflare Pages answers every unknown path with the
// homepage and a 200, which reads to a crawler as endless duplicate pages.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page does not exist.">
  <h1 class="display">Page not found</h1>
  <p class="summary">That page does not exist. It may have been renamed or removed.</p>
  <p class="links">
    <a href="/">Work</a> · <a href="/about">About</a>
  </p>
</Layout>
