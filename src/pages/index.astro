---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import JobCard from '../components/JobCard.astro';
import PittaMark from '../components/PittaMark.astro';
import LinkRow from '../components/LinkRow.astro';
import { certification, currentJob, cv, linkHref } from '../data/cv';
import { formatCatalogueNumber } from '../lib/content';
import { getAllProjects, getJobWork } from '../lib/collections';
import type { TileSize } from '../components/Tile.astro';
import '../styles/pages/home.css';

const projects = await getAllProjects();
const current = projects.filter((project) => !project.data.earlier);
const earlier = projects.filter((project) => project.data.earlier);
const jobProjects = await getJobWork();

// The headline is two sentences: the first in full colour, the second in grey.
const [statementLead, ...statementRest] = cv.statement.split(/(?<=\.)\s+/);
// Selected work: the first project as a wide tile, the others in halves.
const workSize = (i: number): TileSize => (i === 0 ? 'wide' : 'half');
// Personal projects: two halves, then thirds.
const projectSize = (i: number): TileSize => (i < 2 ? 'half' : 'third');

const headlineCert = certification('AWS Certified Solutions Architect – Professional');
// Both AWS Professional certifications, for the proof strip.
const awsProfessional = cv.certifications.filter((cert) => /^AWS Certified .+ – Professional$/.test(cert.name));
const awsNames = awsProfessional.map((cert) => cert.name.replace(/^AWS Certified /, '')).join(' and ');
const awsYears = [...new Set(awsProfessional.map((cert) => cert.year))].join(', ');

// A sketch of a two-note bird call, drawn as a spectrogram: time runs left to
// right, pitch bottom to top, and each cell's strength is how close it sits to
// the call's pitch at that moment. Computed here so the page ships plain SVG.
const COLS = 56;
const ROWS = 14;
function pitchAt(t: number): number | null {
  // First note rises, a short gap, then a longer note that rises and falls.
  if (t < 0.08 || (t > 0.36 && t < 0.46) || t > 0.94) return null;
  if (t <= 0.36) return 3 + ((t - 0.08) / 0.28) * 7;
  const u = (t - 0.46) / 0.48;
  return 5 + Math.sin(u * Math.PI) * 6.5;
}
const cells = [] as { x: number; y: number; strength: number }[];
for (let col = 0; col < COLS; col++) {
  const pitch = pitchAt(col / (COLS - 1));
  for (let row = 0; row < ROWS; row++) {
    const distance = pitch === null ? 99 : Math.abs(row - pitch);
    // A faint floor of noise everywhere, like a real recording.
    const noise = ((col * 7 + row * 13) % 11) / 110;
    const strength = Math.min(1, Math.max(noise, Math.exp(-(distance * distance) / 1.6)));
    cells.push({ x: col, y: ROWS - 1 - row, strength });
  }
}
---

<Layout wide>
  <section class="band band-alt hero" aria-labelledby="hero-title">
    <div class="band-inner band-inner-text">
      <p class="hero-kicker rise" style="--i:0">{cv.name}<span class="handle">{cv.handle}</span></p>
      <h1 class="hero-title rise" style="--i:1" id="hero-title">{statementLead}{statementRest.length > 0 && <> <span class="hero-title-rest">{statementRest.join(' ')}</span></>}</h1>
      <p class="hero-sub rise" style="--i:2">{cv.pitch}</p>
      <p class="hero-cert rise" style="--i:3">
        <a href="/about#certifications">{headlineCert.name}</a><span class="hero-cert-year">{headlineCert.year}</span>
      </p>
      <ul class="hero-facts rise" style="--i:4" aria-label="At a glance">
        <li><span class="sr-only">Role: </span>{currentJob().role}</li>
        <li><span class="sr-only">Based in </span>{cv.location}</li>
        <li><span class="pulse" aria-hidden="true"></span>{cv.availability}</li>
      </ul>
      <p class="actions rise" style="--i:5">
        <a class="action action-primary" href="/contact">Contact</a>
        <a class="link-more" href="#selected-work">Selected work</a>
        <a class="link-more link-external" href={linkHref('LinkedIn')} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>
    </div>
  </section>

  <!-- Three facts, each linked to where it is told in full. The wording comes
       from content/work (finance-saas: team; tuition-ops: outcome) and
       cv.certifications. -->
  <section class="band proof" aria-labelledby="proof-title">
    <div class="band-inner">
      <h2 class="sr-only" id="proof-title">In short</h2>
      <div class="tiles reveal">
        <a class="tile proof-tile tile-third" href="/work/finance-saas">
          <p class="tile-kicker">Led</p>
          <p class="proof-figure">9 engineers</p>
          <p class="tile-text">A team of 9 engineers, on a finance SaaS and LLM agent I designed from scratch</p>
          <span class="link-more">Learn more</span>
        </a>
        <a class="tile proof-tile tile-third" href="/work/tuition-ops">
          <p class="tile-kicker">Delivered</p>
          <p class="proof-figure">10% to near zero</p>
          <p class="tile-text">Invoice errors cut from about 10% to near zero, at about 100 invoices a month</p>
          <span class="link-more">Learn more</span>
        </a>
        <a class="tile proof-tile tile-third" href="/about#certifications">
          <p class="tile-kicker">Certified</p>
          <p class="proof-figure">{awsProfessional.length}× AWS Professional</p>
          <p class="tile-text">AWS {awsNames}, {awsYears}</p>
          <span class="link-more">Learn more</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="selected-work" aria-labelledby="selected-work-title">
    <div class="band-inner">
      <header class="section-head reveal">
        <h2 class="section-heading" id="selected-work-title">Selected work</h2>
        <p class="section-note">Projects from my job, for clients and for the company, each told as a case study. Client names and screenshots are left out.</p>
      </header>
      <div class="tiles">
        {jobProjects.map((project, i) => <JobCard project={project} size={workSize(i)} />)}
      </div>
    </div>
  </section>

  <section class="band" id="personal-projects" aria-labelledby="personal-projects-title">
    <div class="band-inner">
      <header class="section-head reveal">
        <h2 class="section-heading" id="personal-projects-title">Personal projects</h2>
        <p class="section-note">
          Newest first. The bird projects grew out of my ecology degree at Yale-NUS, where I studied bird calls.
        </p>
        <figure class="call">
          <svg class="call-plot" viewBox={`0 0 ${COLS * 10} ${ROWS * 10}`} role="img" aria-label="A spectrogram sketch of a two-note bird call">
            {cells.map((cell) => (
              <rect
                x={cell.x * 10 + 1}
                y={cell.y * 10 + 1}
                width="8"
                height="8"
                rx="2"
                class:list={['call-cell', { 'call-peak': cell.strength > 0.8 }]}
                style={`--a:${cell.strength.toFixed(2)}`}
              />
            ))}
          </svg>
          <figcaption class="call-caption"><span>Fairy pitta call</span><span>0–2 s, 1–8 kHz</span></figcaption>
        </figure>
      </header>
      <div class="tiles">
        {current.map((project, i) => <ProjectCard project={project} size={projectSize(i)} priority={i < 2} />)}
      </div>
    </div>
  </section>

  {earlier.length > 0 && (
    <section class="band band-alt" id="earlier" aria-labelledby="earlier-title">
      <!-- Older work, kept quiet: a small heading rather than a headline, and
           one short row per project. -->
      <div class="band-inner earlier-inner">
        <header class="section-head section-head-quiet reveal">
          <h2 class="quiet-title" id="earlier-title">Earlier</h2>
          <p class="section-note">Older projects, kept for the record.</p>
        </header>
        <ul class="list link-list reveal">
          {earlier.map((project) => (
            <LinkRow
              href={`/projects/${project.slug}`}
              title={project.data.title}
              desc={project.data.summary}
              meta={`No. ${formatCatalogueNumber(project.number)} · ${project.date.getUTCFullYear()}`}
            />
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band about reveal" aria-labelledby="about-title">
    <div class="band-inner band-inner-text">
      <h2 class="section-heading" id="about-title">About <PittaMark /></h2>
      <p class="about-text">{cv.summary}</p>
      <p class="actions">
        <a class="action action-primary" href="/about">History &amp; certifications</a>
        <a class="link-more" href="/contact">Contact</a>
      </p>
    </div>
  </section>
</Layout>
