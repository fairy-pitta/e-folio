---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import JobCard from '../components/JobCard.astro';
import Row from '../components/Row.astro';
import { cv } from '../data/cv';
import { formatCatalogueNumber, getAllProjects } from '../lib/content';

const projects = getAllProjects();
const current = projects.filter((project) => !project.frontmatter.earlier);
const earlier = projects.filter((project) => project.frontmatter.earlier);
const jobProjects = cv.experience.flatMap((job) => job.projects ?? []);
---

<Layout wide>
  <section class="intro">
    <h1 class="display">{cv.name} <span class="handle">{cv.handle}</span></h1>
    <p class="intro-pitch">{cv.pitch}</p>
    <p class="intro-meta">
      <span class="availability-badge">{cv.availability}</span>
      <span>{cv.headline} · {cv.location}</span>
    </p>
    <p class="actions">
      <a class="action action-primary" href="/about">About &amp; history</a>
      <a class="action" href="/contact">Contact</a>
    </p>
  </section>

  <section class="section" aria-labelledby="job-projects">
    <h2 class="section-title" id="job-projects">At work</h2>
    <p class="section-note">Projects from my job, for clients and for the company. Client names and screenshots are left out.</p>
    <div class="specimens">
      {jobProjects.map((project) => <JobCard project={project} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="personal-projects">
    <h2 class="section-title" id="personal-projects">Personal projects</h2>
    <p class="section-note">
      Newest first. The bird projects grew out of my ecology degree at Yale-NUS, where I studied bird calls.
    </p>
    <div class="specimens">
      {current.map((project, i) => <ProjectCard project={project} priority={i < 3} />)}
    </div>
  </section>

  {earlier.length > 0 && (
    <section class="section" aria-labelledby="earlier">
      <h2 class="section-title" id="earlier">Earlier</h2>
      <div class="list">
        {earlier.map((project) => (
          <Row meta={`No. ${formatCatalogueNumber(project.number)} · ${project.date.getUTCFullYear()}`}>
            <a href={`/projects/${project.slug}`}>{project.frontmatter.title}</a>
            <span class="muted"> — {project.frontmatter.description}</span>
          </Row>
        ))}
      </div>
    </section>
  )}
</Layout>
