---
import Layout from '../../layouts/Layout.astro';
import { Badge } from '../../components/ui/badge';
import { getProject, getAllProjectSlugs } from '../../lib/content';
import { markdownToHtml } from '../../lib/markdown';
import ScrollToTop from '../../components/scroll-to-top';
import Navbar from '../../components/navbar';
import Footer from '../../components/Footer.astro';
import { ArrowLeftIcon, CalendarIcon, EyeIcon, Github } from 'lucide-react';
import '../../styles/globals.css';

export async function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map((slug) => ({
    params: { slug: slug.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect('/404');
}

const contentHtml = await markdownToHtml(project.content);
const title = `${project.frontmatter.title} | SingBirds`;
const description = project.frontmatter.description;
const ogImage = `/og/project-${slug}.png`;
---

<Layout title={title} description={description} ogImage={ogImage}>
  <Navbar client:idle />
  <ScrollToTop client:visible>
    <div class="min-h-screen bg-background">
      <div class="pt-14 md:pt-16">
        <div class="container mx-auto px-4 py-12">
          <div class="max-w-4xl mx-auto">
            <a
              href="/projects"
              data-astro-prefetch
              class="mb-8 inline-flex items-center gap-2 text-sm font-mono text-muted-foreground hover:text-foreground transition-colors"
            >
              <ArrowLeftIcon className="h-3.5 w-3.5 mr-1.5" />
              Back
            </a>

            <div class="grid grid-cols-1 gap-8 mb-8">
              <div>
                {project.frontmatter.coverImage && (
                  <div class="mb-6">
                    <img
                      src={project.frontmatter.coverImage}
                      alt={project.frontmatter.title}
                      width="1280"
                      height="720"
                      class="w-full rounded-sm border object-cover cursor-zoom-in"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                      data-zoom="true"
                    />
                  </div>
                )}

                <!-- Modal for image popup -->
                <dialog id="image-modal" class="rounded-sm p-0 backdrop:bg-black/60">
                  <div class="relative">
                    <button
                      class="absolute right-3 top-3 z-10 font-mono text-xs px-3 py-1.5 bg-foreground text-background hover:bg-[hsl(var(--accent))] transition-colors"
                      id="image-modal-close"
                    >
                      Close
                    </button>
                    <img id="image-modal-img" src="" alt="Expanded image" class="max-h-[85vh] w-auto object-contain rounded-sm" />
                  </div>
                </dialog>

                <h1 class="text-2xl md:text-3xl font-mono-heading mb-4">{project.frontmatter.title}</h1>
                <p class="text-lg text-muted-foreground mb-6">{project.frontmatter.description}</p>
                
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.frontmatter.tags.map((tech: string) => (
                    <Badge variant="secondary" className="text-xs font-mono">{tech}</Badge>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-4 mb-6">
                  <span class="flex items-center text-muted-foreground">
                    <CalendarIcon className="h-4 w-4 mr-1" />
                    {project.frontmatter.date}
                  </span>
                </div>

                <div class="flex gap-3">
                  {project.frontmatter.githubUrl && (
                    <a
                      href={project.frontmatter.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 font-mono text-sm px-4 py-2 bg-foreground text-background hover:bg-[hsl(var(--accent))] transition-colors"
                    >
                      <Github className="h-3.5 w-3.5" />
                      Code
                    </a>
                  )}
                  {project.frontmatter.liveUrl && (
                    <a
                      href={project.frontmatter.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 font-mono text-sm px-4 py-2 border border-foreground hover:border-[hsl(var(--accent))] hover:text-[hsl(var(--accent))] transition-colors"
                    >
                      <EyeIcon className="h-3.5 w-3.5" />
                      Live
                    </a>
                  )}
                </div>

                
              </div>
            </div>

            <div class="prose prose-neutral prose-img:rounded-sm prose-headings:scroll-mt-8 prose-headings:font-mono prose-headings:tracking-tight prose-a:text-[hsl(153,40%,28%)] prose-a:underline-offset-2 max-w-none sm:prose-lg" set:html={contentHtml} />

            {project.frontmatter.gallery && project.frontmatter.gallery.length > 0 && (
              <div class="mt-12">
                <h2 class="text-xl font-mono-heading mb-6">Gallery</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-6">
                  {project.frontmatter.gallery.map((img: string) => (
                    <img
                      src={img}
                      alt={`${project.frontmatter.title} gallery image`}
                      class="w-full rounded-sm border object-cover cursor-zoom-in"
                      loading="lazy"
                      decoding="async"
                      data-zoom="true"
                    />
                  ))}
                </div>
              </div>
            )}

            <script>
              document.addEventListener('DOMContentLoaded', () => {
                const dialog = document.getElementById('image-modal') as HTMLDialogElement | null;
                const modalImg = document.getElementById('image-modal-img') as HTMLImageElement | null;
                const closeBtn = document.getElementById('image-modal-close') as HTMLButtonElement | null;

                document.querySelectorAll('img[data-zoom="true"]').forEach((el) => {
                  el.addEventListener('click', () => {
                    if (dialog && modalImg) {
                      modalImg.src = (el as HTMLImageElement).src;
                      dialog.showModal();
                    }
                  });
                });

                closeBtn?.addEventListener('click', () => {
                  if (dialog) dialog.close();
                });
              });
            </script>
          </div>
        </div>
      </div>
    </div>
  </ScrollToTop>
  <Footer />
</Layout>