---
import CaseStudy from '../../layouts/CaseStudy.astro';
import {
  formatCatalogueNumber,
  formatMonthYear,
  projectLinks,
  projectStatus,
  runsInTerminal,
  screenTitle,
  type Project,
} from '../../lib/content';
import { getAllProjects } from '../../lib/collections';
import { markdownToHtml } from '../../lib/markdown';
import { resolveMedia } from '../../lib/media';
import { projectStars } from '../../lib/github';

export async function getStaticPaths() {
  // Newest first, as on the home page: "next" is the one made before this.
  const projects = await getAllProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, newer: projects[i - 1], older: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  newer?: Project;
  older?: Project;
}

const { project, newer, older } = Astro.props;
const { data } = project;
const pager = [
  newer && { label: 'Previous', rel: 'prev', project: newer },
  older && { label: 'Next', rel: 'next', project: older },
]
  .filter((item): item is { label: string; rel: 'prev' | 'next'; project: Project } => Boolean(item))
  .map((item) => ({
    rel: item.rel,
    href: `/projects/${item.project.slug}`,
    title: item.project.data.title,
    meta: `${item.label} · No. ${formatCatalogueNumber(item.project.number)}`,
  }));
const stars = await projectStars(data.links.code);
const cover = data.media.cover;
// Every screenshot and recording is shown on the drawn monitor.
const shots = await Promise.all(
  [cover, ...data.media.gallery]
    .filter((src): src is string => Boolean(src))
    .map(async (src, i) => ({ media: await resolveMedia(src), cover: Boolean(cover) && i === 0 })),
);
---

<CaseStudy
  title={data.title}
  description={data.summary}
  ogImage={`/og/project-${project.slug}.png`}
  kicker="Personal project"
  status={projectStatus(data.links)}
  lead={data.summary}
  highlight={data.highlight}
  labels={[
    { label: 'No.', value: formatCatalogueNumber(project.number) },
    { label: 'When', value: `Built ${formatMonthYear(project.date)}` },
    data.stack && { label: 'Stack', value: data.stack },
    stars && { label: 'Stars', value: stars },
    data.tags.length > 0 && { label: 'Tags', value: data.tags.join(', ') },
  ]}
  actions={projectLinks(data.links).map((link) => ({
    label: link.label,
    href: link.href,
    primary: link.kind === 'live',
    external: true,
  }))}
  screen={shots.length > 0 ? { variant: runsInTerminal(data) ? 'terminal' : 'browser', title: screenTitle(project.slug, data), shots } : undefined}
  study={data.case}
  html={await markdownToHtml(project.content)}
  pager={pager}
  pagerLabel="More projects"
  back={{ href: '/#personal-projects', label: 'All personal projects' }}
/>
