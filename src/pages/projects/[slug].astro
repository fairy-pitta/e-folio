---
import Layout from '../../layouts/Layout.astro';
import {
  getAllProjects,
  formatCatalogueNumber,
  formatMonthYear,
  projectLinks,
  projectStatus,
  type Project,
} from '../../lib/content';
import { markdownToHtml } from '../../lib/markdown';
import Figure from '../../components/Figure.astro';
import Stamp from '../../components/Stamp.astro';
import { projectStars } from '../../lib/github';

export function getStaticPaths() {
  return getAllProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { frontmatter } = project;
const html = await markdownToHtml(project.content);
const links = projectLinks(frontmatter);
const stars = await projectStars(frontmatter.githubUrl);
const gallery = (frontmatter.gallery ?? []).filter((src) => src.trim() !== '');
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={`/og/project-${project.slug}.png`}
>
  <p class="crumb"><a href="/">Work</a> / No. {formatCatalogueNumber(project.number)}</p>
  <h1 class="display">{frontmatter.title}</h1>
  <p class="summary">{frontmatter.description}</p>
  <dl class="specimen-label specimen-label-page">
    <dt>No.</dt><dd>{formatCatalogueNumber(project.number)} <Stamp label={projectStatus(frontmatter)} /></dd>
    <dt>Built</dt><dd>{formatMonthYear(project.date)}</dd>
    {frontmatter.stack && <><dt>Stack</dt><dd>{frontmatter.stack}</dd></>}
    {frontmatter.highlight && <><dt>Highlight</dt><dd>{frontmatter.highlight}</dd></>}
    {stars && <><dt>Stars</dt><dd>{stars}</dd></>}
    {frontmatter.tags.length > 0 && <><dt>Tags</dt><dd>{frontmatter.tags.join(', ')}</dd></>}
  </dl>
  {links.length > 0 && (
    <p class="actions">
      {links.map((link) => (
        <a class:list={['action', { 'action-primary': link.kind === 'live' }]} href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </p>
  )}

  {frontmatter.coverImage?.trim() && (
    <Figure src={frontmatter.coverImage} alt={frontmatter.title} priority />
  )}

  <article class="prose" set:html={html} />

  {gallery.map((src) => (
    <Figure src={src} alt={`${frontmatter.title} screenshot`} />
  ))}

  <p class="footer-nav">← <a href="/">All work</a></p>
</Layout>
