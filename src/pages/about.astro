---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import LabelList from '../components/LabelList.astro';
import Section from '../components/Section.astro';
import Row from '../components/Row.astro';
import Timeline from '../components/Timeline.astro';
import { currentJob, cv } from '../data/cv';
import { jobHistory, studyHistory } from '../lib/history';
import { getJobWork } from '../lib/collections';

const jobs = jobHistory(cv.experience, await getJobWork());
const schools = studyHistory(cv.education);
---

<Layout title="About">
  <PageHead lead={cv.summary}>
    <Fragment slot="title">{cv.name}<span class="handle">{cv.handle}</span></Fragment>
    <ul class="bullets strengths rise" style="--i:3">
      {cv.strengths.map((line) => <li>{line}</li>)}
    </ul>
    <LabelList
      rise={4}
      items={[
        { label: 'Role', value: currentJob().role },
        { label: 'Based', value: cv.location },
        { label: 'Links', slot: 'links' },
        { label: 'Status', value: cv.availability },
      ]}
    >
      <span slot="links" class="label-links">
        {cv.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </span>
    </LabelList>
  </PageHead>

  <section class="section" id="certifications">
    <h2 class="section-title">Certifications</h2>
    <div class="list">
      {cv.certifications.map((cert) => (
        <Row meta={cert.year}>
          <a href={cert.href} target="_blank" rel="noopener noreferrer">{cert.name}</a>
        </Row>
      ))}
    </div>
  </section>

  <Section title="Skills">
    <dl class="skills">
      {cv.skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <section class="section" id="history">
    <h2 class="section-title">History</h2>
    <Timeline entries={jobs} open="first" />
  </section>

  <section class="section" id="education">
    <h2 class="section-title">Education</h2>
    <Timeline entries={schools} open="all" />
  </section>

  <Section title="Awards">
    <div class="list">
      {cv.awards.map((award) => (
        <Row meta={award.period}>{award.title}</Row>
      ))}
    </div>
  </Section>

  <section class="section about-close" aria-label="Get in touch">
    <p class="about-close-note">CV available on request.</p>
    <p class="actions">
      <a class="action action-primary" href="/contact">Contact</a>
    </p>
  </section>
</Layout>
